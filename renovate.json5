{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>JacobPEvans/.github:renovate-nix",
  ],
  // Commits by the hash-fix App bot do not mark a Renovate branch as edited.
  "gitIgnoredAuthors": ["264163489+jacobpevans-claude[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^mlx-server\\/pyproject\\.toml$/"],
      "matchStrings": [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) currentValue=(?<currentValue>\\S+) extractVersion=(?<extractVersion>\\S+)\\n\\s+"mlx-vlm @ https://github\\.com/Blaizzy/mlx-vlm/archive/(?<currentDigest>[a-f0-9]{40})\\.zip"',
      ],
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^lib\\/versions\\.nix$/"],
      "matchStrings": [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) currentValue=(?<currentValue>\\S+) extractVersion=(?<extractVersion>\\S+)\\n\\s*mlxLmPrInstallSpec = "mlx-lm @ git\\+https://github\\.com/jundot/mlx-lm\\.git@(?<currentDigest>[a-f0-9]{40})";',
      ],
    },
    {
      // The hash-fix workflow runs nix-update from a commit-pinned flake reference
      // with its release tag in a trailing comment; both move together.
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/fix-renovate-hashes\\.yml$/"],
      "matchStrings": [
        'nix run github:(?<depName>Mic92\\/nix-update)\\/(?<currentDigest>[0-9a-f]{40})#nix-update .* # (?<currentValue>v\\S+)',
      ],
      "datasourceTemplate": "github-tags",
    },
  ],
  "packageRules": [
    {
      "description": [
        "Exclude a ZCode release that fails pnpm install in the Nix build on",
        "x86_64-linux with ENOENT on react-scan/node_modules/esbuild. Newer",
        "releases pass this rule. Remove it after one of them builds.",
      ],
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["zai-org/ZCode"],
      "allowedVersions": "!/^v?3\\.17\\.1$/",
    },
    {
      "description": [
        "Exclude a transformers release that breaks mlx-lm during import; the",
        "release fails while registering a model and prevents worker startup.",
        "Remove the restriction after upstream fixes the registration behavior.",
      ],
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["transformers"],
      "allowedVersions": "!/^5\\.13\\.0$/",
    },
    {
      "description": [
        "Keep huggingface-hub below the next major release while tokenizers",
        "requires the current major. Remove the hold when tokenizers supports",
        "the next major release.",
      ],
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["huggingface-hub"],
      "allowedVersions": "<2.0.0",
    },
    {
      "description": [
        "Hold the interpreter pin if Renovate annotations are added to",
        "lib/python.nix. Keep this hold scoped to that file so other pins and",
        "lockfile maintenance remain enabled.",
      ],
      "matchFileNames": ["lib/python.nix"],
      "enabled": false,
    },
    {
      "description": "Follow omo-ai's beta release stream instead of npm's separate latest tag.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["omo-ai"],
      "followTag": "beta",
    },
    {
      "description": [
        "Classify jacobpevans-cc-plugins flake input updates as fixes so Release",
        "Please releases each bump.",
      ],
      "matchDepNames": ["jacobpevans-cc-plugins"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps",
    },
  ],
}
